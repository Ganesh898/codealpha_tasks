<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cyber Security Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f2f5f9 0%, #dbe3ed 100%);
            min-height: 100vh;
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: #1f2937;
        }

        .glass-card {
            background: #ffffff;
            border: none;
            border-radius: 24px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
        }

        .form-control {
            background: #f8fafc;
            border: 1px solid #d1d5db;
            border-radius: 12px;
            color: #111827;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-control:focus {
            background: #ffffff;
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
            color: #111827;
        }

        label {
            font-weight: 600;
            color: #374151;
        }

        .btn-cyber {
            background: #2563eb;
            border: none;
            color: #ffffff;
            font-weight: 600;
            border-radius: 999px;
            padding: 0.85rem 1rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-cyber:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
            box-shadow: 0 16px 30px rgba(37, 99, 235, 0.18);
        }

        .btn-outline-light {
            color: #2563eb;
            border-color: #c7d2fe;
            background: #eff6ff;
            border-radius: 999px;
        }

        .btn-outline-light:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .text-muted {
            color: #6b7280 !important;
        }

        a {
            color: #2563eb;
        }

        .card .text-center h2 {
            letter-spacing: -0.03em;
        }
    </style>
</head>
<body>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card glass-card p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">E-Commerce Login</h2>
                    <p class="mb-0 text-muted">Access your account and continue shopping</p>
                </div>

                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input type="email" name="email" class="form-control" placeholder="Enter your email" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="remember">
                            <label class="form-check-label" for="rememberMe">Remember me</label>
                        </div>
                        <a href="#" class="text-decoration-none" style="color: #00ff41;">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-cyber w-100">Sign In</button>
                </form>

                <div class="text-center mt-4">
                    <p class="mb-1 text-muted">New customer?</p>
                    <a href="/register" class="btn btn-outline-light btn-sm">Create an account</a>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>